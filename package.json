{
  "name": "minuk-hwang-design-system",
  "version": "1.0.0",
  "description": "Modern design system built with React, TypeScript, and Vanilla Extract",
  "private": true,
  "scripts": {
    "prepare": "husky",
    "dev": "nx dev",
    "dev:docs": "pnpm build:packages && pnpm --filter @minuk-hwang-design-system/docs dev",
    "build:docs": "pnpm build:packages && pnpm --filter @minuk-hwang-design-system/docs build",
    "graph": "nx run-many --target=build --graph",
    "build": "nx build",
    "build:all": "nx run-many --target=build --all",
    "build:packages": "nx run-many --target=build --projects=@minuk-hwang-design-system/style-tokens,@minuk-hwang-design-system/base-react,@minuk-hwang-design-system/behavior-react,@minuk-hwang-design-system/components-react",
    "build:dev": "nx build:dev",
    "clean": "nx clean",
    "clean:all": "nx run-many --target=clean --all",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx --cache --cache-location .eslintcache",
    "lint:fix": "eslint . --ext .ts,.tsx,.js,.jsx --cache --cache-location .eslintcache --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "echo \"Error: no test specified\" && exit 1",
    "publish:tokens": "pnpm --filter @minuk-hwang-design-system/style-tokens build && pnpm --filter @minuk-hwang-design-system/style-tokens publish --access public --no-git-checks",
    "publish:behavior": "pnpm --filter @minuk-hwang-design-system/behavior-react build && pnpm --filter @minuk-hwang-design-system/behavior-react publish --access public --no-git-checks",
    "publish:base": "pnpm --filter @minuk-hwang-design-system/base-react build && pnpm --filter @minuk-hwang-design-system/base-react publish --access public --no-git-checks",
    "publish:react": "pnpm --filter @minuk-hwang-design-system/components-react build && pnpm --filter @minuk-hwang-design-system/components-react publish --access public --no-git-checks",
    "publish:all": "pnpm publish:tokens && pnpm publish:behavior && pnpm publish:base && pnpm publish:react"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "prettier --write"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  },
  "keywords": [
    "design-system",
    "react",
    "typescript",
    "vanilla-extract",
    "components"
  ],
  "author": "Minuk Hwang",
  "license": "MIT",
  "packageManager": "pnpm@8.15.0",
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@typescript-eslint/eslint-plugin": "^8.43.0",
    "@typescript-eslint/parser": "^8.43.0",
    "commitlint-config-gitmoji": "^2.3.1",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-json-format": "^2.0.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "gitmoji-cli": "^9.7.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.6",
    "nx": "^21.5.1",
    "prettier": "^3.3.3",
    "typescript": "^5.5.4"
  }
}
