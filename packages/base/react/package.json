{
  "name": "@minuk-hwang-design-system/base-react",
  "version": "0.0.1",
  "type": "module",
  "packageManager": "pnpm@8.15.0",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    "./package.json": "./package.json",
    "./*": {
      "types": "./dist/*/index.d.ts",
      "import": "./dist/*/index.js",
      "require": "./dist/*/index.cjs"
    }
  },
  "scripts": {
    "build": "pnpm clean && pnpm build:type && pnpm build:js",
    "build:dev": "pnpm build:js --dev --watch & pnpm build:type --watch",
    "dev": "node build.js --dev --watch",
    "build:js": "node build.js",
    "build:type": "tsc --emitDeclarationOnly",
    "clean": "rimraf dist",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "author": "Minuk Hwang",
  "license": "MIT",
  "description": "React base components for the Minuk Hwang Design System",
  "homepage": "https://github.com/minukHwang/minuk-hwang-design-system/tree/main/packages/base-react#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/minukHwang/minuk-hwang-design-system.git",
    "directory": "packages/base/react"
  },
  "bugs": {
    "url": "https://github.com/minukHwang/minuk-hwang-design-system/issues"
  },
  "keywords": [
    "react-base-components",
    "design-system",
    "base-component-library",
    "vanilla-extract",
    "base-components",
    "frontend",
    "minuk-hwang-design-system"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "package.json"
  ],
  "sideEffects": false,
  "devDependencies": {
    "@minuk-hwang-design-system/esbuild-config": "workspace:^",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "esbuild": "^0.23.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rimraf": "^6.0.1",
    "typescript": "^5.5.3"
  },
  "peerDependencies": {
    "react": "*"
  },
  "dependencies": {
    "@minuk-hwang-design-system/behavior-react": "workspace:^",
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toast": "^1.2.23",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@radix-ui/react-visually-hidden": "^1.2.11"
  }
}
