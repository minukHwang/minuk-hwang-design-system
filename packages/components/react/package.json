{
  "name": "@minuk-hwang-design-system/components-react",
  "version": "0.0.2",
  "type": "module",
  "packageManager": "pnpm@8.15.0",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    "./package.json": "./package.json",
    "./shared": null,
    "./*": {
      "types": "./dist/*/index.d.ts",
      "import": "./dist/*/index.js",
      "require": "./dist/*/index.cjs"
    },
    "./*/style": {
      "types": "./dist/*/index.css.d.ts",
      "default": "./dist/*/index.css"
    }
  },
  "scripts": {
    "build": "pnpm clean && pnpm build:type && pnpm build:js",
    "build:dev": "pnpm build:js --dev --watch & pnpm build:type --watch",
    "dev": "node build.js --dev --watch",
    "build:js": "node build.js",
    "build:type": "tsc --emitDeclarationOnly",
    "clean": "rimraf dist",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "author": "Minuk Hwang",
  "license": "MIT",
  "description": "React components for the Minuk Hwang Design System",
  "homepage": "https://github.com/minukHwang/minuk-hwang-design-system/tree/main/packages/components-react#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/minukHwang/minuk-hwang-design-system.git",
    "directory": "packages/components/react"
  },
  "bugs": {
    "url": "https://github.com/minukHwang/minuk-hwang-design-system/issues"
  },
  "keywords": [
    "react-components",
    "design-system",
    "component-library",
    "vanilla-extract",
    "sprinkles",
    "recipes",
    "css-variables",
    "ui",
    "frontend",
    "minuk-hwang-design-system"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "package.json"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "devDependencies": {
    "@minuk-hwang-design-system/esbuild-config": "workspace:^",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vanilla-extract/esbuild-plugin": "^2.3.8",
    "esbuild": "^0.23.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rimraf": "^6.0.1",
    "typescript": "^5.5.3"
  },
  "peerDependencies": {
    "react": "*",
    "react-dom": "*"
  },
  "dependencies": {
    "@minuk-hwang-design-system/base-react": "workspace:^",
    "@minuk-hwang-design-system/style-tokens": "workspace:^",
    "@vanilla-extract/css": "^1.15.3",
    "@vanilla-extract/recipes": "^0.5.3",
    "clsx": "^2.1.1"
  }
}
