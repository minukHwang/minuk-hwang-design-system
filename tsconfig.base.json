{
  "compilerOptions": {
    // Compile against the latest ECMAScript standard
    "target": "ESNext",
    // Emit native ES modules
    "module": "ESNext",
    // Type definitions available to every package
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    // Generate .d.ts declaration files
    "declaration": true,
    // Enable the full set of strict type checks
    "strict": true,
    // Resolve modules the way bundlers do (respects package "exports")
    "moduleResolution": "bundler",
    // React 17+ automatic JSX runtime
    "jsx": "react-jsx",
    // Allow emit (the flag below narrows it to declarations only)
    "noEmit": false,
    // tsc only emits types; esbuild owns the JavaScript output
    "emitDeclarationOnly": true,
    // Use [[Define]] semantics for class fields
    "useDefineForClassFields": true,
    // Skip type checking of dependency .d.ts files for faster builds
    "skipLibCheck": true,
    // Allow importing .json files as modules
    "resolveJsonModule": true,
    // Treat every file as an isolated module
    "isolatedModules": true,
    // Report unused locals as errors
    "noUnusedLocals": true,
    // Report unused parameters as errors
    "noUnusedParameters": true,
    // Forbid accidental switch-case fallthrough
    "noFallthroughCasesInSwitch": true

    // Path aliases are deliberately absent.
    //
    // Pointing an alias at another package's src pulls that source into the
    // current package's program and violates rootDir (TS6059). More importantly
    // it erases the layer boundary: a package would compile against a sibling's
    // internals instead of its published surface.
    //
    // Cross-package imports resolve through pnpm workspace symlinks to the
    // dist/*.d.ts each package advertises in its "exports" map. Dependencies
    // must therefore be built first, which nx guarantees via dependsOn: ["^build"].
  }
}
